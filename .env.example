# Copy to .env and run `docker compose up --build`. No edits required.
# The literal dev credentials below are deliberately obvious non-defaults.
# Every comment is on its own line: Node's --env-file and dotenv disagree about
# trailing `# ...` on a value, and this file has to work for all of them.

# --- app (S2) ---

# Kept 'development' for the local compose demo, which runs over plain HTTP on
# localhost. The cookie Secure flag will be derived from APP_URL's scheme, not
# from NODE_ENV (S5) — setting this to 'production' here would otherwise mark
# cookies Secure and the browser would drop them over http://localhost.
NODE_ENV=development
PORT=3000
WEB_DIST_PATH=./web/dist

# --- postgres (S2) ---
# Used by compose; DATABASE_URL is derived from these three inside
# docker-compose.yml so a changed password can't half-break the stack.
POSTGRES_USER=blkbox
# dev only — change in any real deployment
POSTGRES_PASSWORD=localdev
POSTGRES_DB=blkbox
# For `pnpm dev` outside compose, uncomment and use:
# DATABASE_URL=postgres://blkbox:localdev@localhost:5432/blkbox

# --- minio (S2) ---
# S3_ACCESS_KEY / S3_SECRET_KEY are derived in compose from MINIO_ROOT_*.
# dev only — change in any real deployment
MINIO_ROOT_USER=localdev
# dev only — change in any real deployment
MINIO_ROOT_PASSWORD=localdev-not-for-prod
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=blkbox-docs
S3_FORCE_PATH_STYLE=true

# --- storage driver (S4) ---
# s3 | local
STORAGE_DRIVER=s3
LOCAL_STORAGE_PATH=./var/storage

# --- auth / sessions (S5) ---
# dev only — change in any real deployment
SESSION_SECRET=localdev-session-secret-change-in-prod

# --- links & invites (S7 / S10) ---
APP_URL=http://localhost:3000

# --- uploads (S9) ---
# 50 MiB
MAX_UPLOAD_BYTES=52428800

# --- rate limiting ---
# Attempts per 15 minutes per IP on login, signup and share-link unlock.
RATE_LIMIT_MAX=10
